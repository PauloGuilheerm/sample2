generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model City {
  id         Int     @id @default(autoincrement())
  name       String
  state      String?
  country    String? @default("Brasil")
  lat        Float?
  lon        Float?
  population Int?
  timezone   String?
  ibgeCode   String? @unique

  @@index([name])               
  @@index([state])
  @@unique([name, state, country])
}

